# Provide through the host's secret manager/environment. This file contains no real credentials.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:8080
# Host process binding above. Docker bridge: override to http://0.0.0.0:8080,
# publish only on host loopback and configure the exact trusted proxy peer.
DATABASE_PROVIDER=sqlite
CONNECTION_STRING=Data Source=/var/lib/veterinar/clinic.db;Default Timeout=5
DATA_PROTECTION_KEYS=/var/lib/veterinar/keys
PUBLIC_ORIGIN=https://clinic.example.cz
AllowedHosts=clinic.example.cz
CORS_ORIGIN=https://clinic.example.cz
COOKIE_SECURE=true
CSRF_SECRET=
TRUSTED_PROXIES=127.0.0.1,::1
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=true
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
# Only needed for --initialize-database when creating the first account. Remove from web service afterwards.
ADMIN_EMAIL=
ADMIN_PASSWORD=
