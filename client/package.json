{
  "name": "veterinar-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node ../scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run sync-editor && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "preview:perf": "vite preview --host 127.0.0.1 --port 4173",
    "lighthouse:home": "npx --yes lighthouse http://127.0.0.1:4173/ --quiet --chrome-flags=\"--headless=new --no-sandbox\" --only-categories=performance --output=html --output=json --output-path=../tmp/lighthouse-home",
    "sync-editor": "node scripts/sync-editor.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:client": "npm run sync-editor && vite --host 127.0.0.1"
  },
  "dependencies": {
    "@tinymce/tinymce-react": "6.3.1",
    "dompurify": "3.4.16",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tinymce": "8.9.3"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
